        {
            "m_Id": "144e3217e4b14883b03e16f7b1ced413"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "shunt",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float res1 = lerp(0,1,x/a);\nfloat res2 = 1;\nfloat res3 = lerp(1,0,(x-b)/(c-b));\nresult = lerp(res1,lerp(res2,res3,step(b,x)),step(a,x));"
}

