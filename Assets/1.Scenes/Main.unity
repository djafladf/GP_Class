      m_Calls: []
  m_text: "\uB85C\uADF8\uB77C\uC774\uD06C \uAE30\uBC18\uC758 \uC288\uD305 \uAC8C\uC784\uC785\uB2C8\uB2E4.\n\uC2A4\uD14C\uC774\uC9C0
    \uB9C8\uB2E4 \uB79C\uB364\uD558\uAC8C \uC0DD\uC131\uB418\uB294 \uB9F5\uC744 \uD0D0\uD5D8\uD558\uBA70\n\uC801\uB4E4\uC744
    \uBB3C\uB9AC\uCE58\uAC70\uB098, \uD37C\uC990\uC744 \uD574\uACB0\uD558\uC5EC \uC544\uC774\uD15C,\uACBD\uD5D8\uCE58,\uACE8\uB4DC\uB97C
    \uD68D\uB4DD\uD558\uACE0\n\uB79C\uB364 \uB2A5\uB825\uCE58\uB97C \uAC15\uD654\uD558\uAC70\uB098,
    \uC0C1\uC810\uC5D0\uC11C \uB79C\uB364 \uC544\uC774\uD15C\uC744 \uAD6C\uB9E4\uD558\uC5EC\n\uCD5C\uC885
    \uBCF4\uC2A4\uC5D0 \uB3C4\uC804\uD574 \uBCF4\uC138\uC694!"
