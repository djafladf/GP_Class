  m_text: "\uB85C\uADF8\uB77C\uC774\uD06C \uAE30\uBC18\uC758 \uC288\uD305 \uAC8C\uC784\uC785\uB2C8\uB2E4.\n\uC2A4\uD14C\uC774\uC9C0
    \uB9C8\uB2E4 \uB79C\uB364\uD558\uAC8C \uC0DD\uC131\uB418\uB294 \uB9F5\uC744 \uD0D0\uD5D8\uD558\uBA70\n\uC801\uB4E4\uC744
