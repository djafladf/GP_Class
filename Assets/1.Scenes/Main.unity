  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1 : \uD604\uC7AC \uC2A4\uD0EF \uD604\uD669\uC744 \uD655\uC778 \uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.<color=blue>\n\uACF5\uACA9\uB825\t\t    \uC544\uC774\uD15C
    \uD68D\uB4DD \uBC94\uC704\n\uCD5C\uB300 \uCCB4\uB825 \uC99D\uAC00\uB7C9\t   
    \uC7AC\uC7A5\uC804 \uC18D\uB3C4 \uC99D\uAC00\n\uC774\uB3D9\uC18D\uB3C4 \uC99D\uAC00\uB7C9\t   
    \uC7AC\uD654 \uD68D\uB4DD\uB7C9 \uC99D\uAC00\n</color>\n2. \uB9C8\uC6B0\uC2A4\uB97C
    \uC544\uC774\uCF58 \uC704\uC5D0 \uAC00\uC838 \uAC00\uBA74 \n\uD574\uB2F9 \uBB34\uAE30\uC758
    \uC815\uBCF4\uB97C \uC54C \uC218 \uC788\uC2B5\uB2C8\uB2E4<color=blue>\n\uD0C4\uC18D
    : \uD0C4\uD658\uC758 \uC18D\uB3C4\n\uBC18\uB3D9 : \uC0AC\uACA9\uC2DC \uC870\uC900\uC810\uC774
    \uC704\uB85C \uD280\uB294 \uC815\uB3C4\n\uC5F0\uC0AC \uAC04\uACA9 : \uB2E4\uC74C
    \uACF5\uACA9\uAE4C\uC9C0\uC758 \uB300\uAE30\uC2DC\uAC04(s)\n\uD0C4 \uD37C\uC9D0
    : \uC870\uC900\uC810 \uB300\uBE44 \uD0C4\uD658\uC774 \uD37C\uC9C0\uB294 \uC815\uB3C4\n\uD0C4\uCC3D
    : \uBCF4\uC720 \uAC00\uB2A5\uD55C \uCD5C\uB300 \uD0C4\uD658\uB7C9\n1\uD68C \uBC1C\uC0AC
    \uC218 : \uC0AC\uACA9\uC2DC \uBC1C\uC0AC\uB418\uB294 \uD0C4\uD658\uC758 \uC218\n</color>\n3.
    \uD604\uC7AC \uBCF4\uC720\uD55C \uBB34\uAE30 \uBAA9\uB85D\uC744 \uB098\uD0C0\uB0C5\uB2C8\uB2E4."
