  - {fileID: 7000000000000000002}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 7000000000000000003}
  m_BlockName: AssemblyRead
  m_HLSLCode: "void AssemblyRead(inout VFXAttributes attributes, in StructuredBuffer<float4>
    AssemblyData)\n{\n uint index = (attributes.particleId % 8192u) * 3u;\n float4
    pose = AssemblyData[index];\n float4 timing = AssemblyData[index + 1u];\n attributes.position
    = pose.xyz;\n attributes.velocity = float3(0,0,0);\n attributes.lifetime = 1.0;\n
    attributes.age = saturate(timing.x);\n attributes.size = 0.1;\n attributes.alpha
    = 1.0;\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: AssemblyRead
    selectedIndex: 0
