  m_ActivationSlot: {fileID: 7000000000000000009}
  m_BlockName: AssemblyVisibility
  m_HLSLCode: "void AssemblyVisibility(inout VFXAttributes attributes, in StructuredBuffer<float4>
    AssemblyData)\n{\n uint index = (attributes.particleId % 8192u) * 3u;\n float4
    pose = AssemblyData[index];\n float4 timing = AssemblyData[index + 1u];\n float4
    tint = AssemblyData[index + 2u];\n attributes.size = max(attributes.size, 0.0)
    * max(pose.w, 0.0);\n attributes.alpha *= saturate(timing.y) * tint.a;\n attributes.color
    = tint.rgb;\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: AssemblyVisibility
    selectedIndex: 0
